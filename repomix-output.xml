class Monster {
  constructor(data) {
    this.id = data.id;
    this.name = data.name;
    this.type = data.type;
    this.dangerLevel = data.dangerLevel;
    this.year = data.year;
    this.domElt = null;
  }
}

import getTemplate from "./template";


render() {
  const template = document.createElement("template");
  template.innerHTML = getTemplate(this);
  this.domElt = template.content.firstElementChild;
  return this.domElt;
}
</file>

